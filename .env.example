# PharmDVerse Supabase Integration Environment Variables
# Copy this file to .env and fill in your Supabase project credentials

# 1. Supabase Project URL (Found under Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon / Public API Key (Found under Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Optional: PostgreSQL Direct Connection String (For backend servers / Prisma / Drizzle)
# Connection String: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Direct Connection: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres
